# Copy these names into Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# GrowthPilot (GoHighLevel) private integration token and IDs
GHL_API_KEY=
GHL_LOCATION_ID=d2ODc4BKvIvWQB8u2jbF
GHL_CALENDAR_ID=xPed4NyywaP9bTwS7m1l

# Any long random string. Signs the form session so nobody can book against another contact.
FORM_SECRET=

# Booking rules
BOOKING_WINDOW_HOURS=48
MIN_NOTICE_HOURS=2
# If fewer than MIN_SLOTS times are free in the normal window, look FALLBACK_WINDOW_HOURS ahead instead.
FALLBACK_WINDOW_HOURS=72
MIN_SLOTS=3

# Where to send people after they confirm. Leave empty to show the built-in "you're booked" screen.
THANK_YOU_URL=

# Firebase (optional but needed for drop-off reporting). Paste the whole service account JSON on one line.
FIREBASE_SERVICE_ACCOUNT=

# Meta Conversions API (optional). Fires a "Schedule" event when a call is booked.
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Password for the /api/report page
REPORT_KEY=

# Optional: GrowthPilot custom field keys to write answers into (leave empty to use notes only)
GHL_CF_YEAR_GROUP=
GHL_CF_CURRENT_GRADE=
GHL_CF_TARGET_GRADE=
GHL_CF_START=
GHL_CF_INVEST=
GHL_CF_TEEN_NAME=
